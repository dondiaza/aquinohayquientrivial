// EL TRIVIAL DE LA COMUNIDAD — modelo de datos (Fase 1)
//
// Decisiones de diseño:
//
// 1. `Question.payload` (Json) guarda los datos ESPECÍFICOS de cada tipo de prueba
//    (opciones, pistas, pasos a ordenar…). Los campos que se usan para filtrar y
//    seleccionar (type, difficulty, category, status, verified, season) son columnas
//    reales e indexadas. El payload se valida SIEMPRE con Zod en el boundary
//    (src/server/questions/repository.ts) antes de entrar al dominio: la base de datos
//    es flexible, el dominio es estricto.
//    Ventaja: añadir un séptimo tipo de prueba en Fase 2 no requiere migración.
//
// 2. `category` es String y no enum: el enunciado pide que añadir categorías sea
//    trivial. El catálogo vive en src/domain/questions/categories.ts y se valida con Zod.
//
// 3. `GameEventLog` persiste el stream de eventos tipados del motor
//    (GAME_STARTED, QUESTION_STARTED, ANSWER_SUBMITTED…). En Fase 1 es trazabilidad y
//    analítica; en Fase 3 es exactamente lo que viajará por WebSocket.
//
// 4. `User` existe pero no se usa: la experiencia principal es de invitado sin cuenta.

generator client {
  provider      = "prisma-client-js"
  // "rhel-openssl-3.0.x" hace falta para ejecutar en Vercel/Coolify (Linux).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  WHO_IS_IT
  IMPOSTOR
  ORDER_CHAOS
  FINAL_BET
  // Fase 2: las cuatro familias nuevas
  MEMORY_GRID
  MISSING_ITEM
  DECISION
  SEQUENCE
  // Contenido ANHQV: respuesta escrita, sin opciones
  SHORT_ANSWER
}

enum QuestionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum GameStatus {
  IN_PROGRESS
  FINISHED
  ABANDONED
}

enum GameMode {
  SOLO
  PARTY // reservado para Fase 3
}

model Question {
  id               String         @id @default(cuid())
  status           QuestionStatus @default(ACTIVE)
  type             QuestionType
  prompt           String
  explanation      String?
  /// Escala interna 1-10.
  difficulty       Int
  category         String
  season           Int?
  episode          Int?
  characters       String[]       @default([])
  tags             String[]       @default([])
  /// { kind: 'image' | 'audio' | 'video', placeholder: string, src?: string, alt?: string }
  media            Json?
  /// Datos propios del tipo de prueba. Validado con Zod al leer/escribir.
  payload          Json
  basePoints       Int            @default(1000)
  timeLimitSeconds Int
  sourceNote       String?
  verified         Boolean        @default(false)
  /// Destacada por el equipo: el director de partida la prioriza.
  featured         Boolean        @default(false)
  /// Nivel de destripe del pack editorial: none | light | major.
  spoiler          String         @default("none")
  /// Confianza editorial en el dato: high | medium.
  confidence       String         @default("high")
  /// Familia de presentación del pack (emparejar, doble_pista, ficha_rapida…).
  variant          String?
  /// Huella del HECHO preguntado: evita que dos formas del mismo dato salgan en la misma partida.
  factKey          String?
  /// Marcada para revisión humana. Nunca entra en una partida.
  needsReview      Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  stat    QuestionStat?
  answers GameAnswer[]

  @@index([status, type])
  @@index([status, category])
  @@index([status, difficulty])
  @@index([status, verified])
  @@index([status, featured])
  @@index([status, spoiler])
  @@index([factKey])
  @@index([needsReview])
}

/// Analítica del banco de preguntas: permite recalibrar dificultades más adelante.
model QuestionStat {
  questionId          String   @id
  question            Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  timesShown          Int      @default(0)
  timesAnswered       Int      @default(0)
  timesCorrect        Int      @default(0)
  /// Mostradas y no respondidas (tiempo agotado o abandono).
  timesAbandoned      Int      @default(0)
  totalResponseMs     Int      @default(0)
  totalPoints         Int      @default(0)
  /// Dificultad 1-10 derivada de la tasa de acierto real (null hasta tener muestras).
  estimatedDifficulty Float?
  updatedAt           DateTime @updatedAt
}

/// Jugador anónimo identificado por cookie. No requiere registro.
model GuestPlayer {
  id          String   @id @default(cuid())
  /// Identificador anónimo del navegador (cookie ahqv_guest).
  publicId    String   @unique
  displayName String?
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  /// Cuenta a la que se ha atado este invitado, si el jugador se registró después.
  /// La migración invitado -> cuenta es rellenar esta columna: nada se copia ni se pierde.
  userId String?
  user   UserAccount? @relation(fields: [userId], references: [id], onDelete: SetNull)

  games        Game[]
  profile      PlayerProfile?
  bests        PersonalBest[]
  dailyResults DailyResult[]

  @@index([userId])
}

model Game {
  id                 String      @id @default(cuid())
  guestId            String
  guest              GuestPlayer @relation(fields: [guestId], references: [id], onDelete: Cascade)
  status             GameStatus  @default(IN_PROGRESS)
  mode               GameMode    @default(SOLO)
  formatId           String
  difficultyId       String
  categoryId         String
  adaptiveDifficulty Boolean     @default(true)
  /// Semilla del RNG: la misma configuración + semilla reproduce la misma partida.
  seed               String
  /// GameConfig completo (validado con Zod).
  config             Json
  /// Banco reducido con el que juega esta partida. Permite recargar la página sin perderla.
  poolIds            String[]    @default([])
  /// GameSummary al finalizar (null mientras esté en curso).
  summary            Json?
  totalScore         Int         @default(0)
  /// LIBRE | RETO_DIARIO | DESAFIO
  origin             String      @default("LIBRE")
  /// Etiqueta legible del desafío compartible, tipo «#21DESENGANO».
  seedLabel          String?
  /// Día del reto diario (YYYY-MM-DD) si aplica.
  dailyKey           String?
  /// Puntuación acumulada tras cada pregunta: es lo que persigue el modo fantasma.
  ghostTrail         Int[]       @default([])
  createdAt          DateTime    @default(now())
  finishedAt         DateTime?

  answers GameAnswer[]
  events  GameEventLog[]

  @@index([guestId, createdAt])
  @@index([guestId, formatId, difficultyId])
  @@index([dailyKey])
  @@index([status])
}

model GameAnswer {
  id            String   @id @default(cuid())
  gameId        String
  game          Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  roundId       String
  indexInGame   Int
  /// false = tiempo agotado / abandonada.
  answered      Boolean  @default(true)
  correct       Boolean  @default(false)
  /// 0..1 (permite acierto parcial en ORDER_CHAOS).
  accuracy      Float    @default(0)
  responseMs    Int      @default(0)
  pointsAwarded Int      @default(0)
  basePoints    Int      @default(0)
  timeBonus     Int      @default(0)
  streakBonus   Int      @default(0)
  multiplier    Float    @default(1)
  streakAfter   Int      @default(0)
  difficulty    Int      @default(5)
  /// Apuesta de la ronda final, si aplica.
  wager         Int?
  /// Máximo teórico de esta pregunta con sus modificadores: base del índice de rendimiento.
  maxPoints     Int      @default(0)
  powerUpsUsed  String[] @default([])
  /// Respuesta enviada por el jugador (para revisiones y analítica).
  submitted     Json?
  createdAt     DateTime @default(now())

  @@unique([gameId, questionId])
  @@index([gameId, indexInGame])
}

/// Stream de eventos del motor. En Fase 3 este mismo contrato viaja por WebSocket.
model GameEventLog {
  id        Int      @id @default(autoincrement())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  seq       Int
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@unique([gameId, seq])
  @@index([gameId, seq])
}

// ── Perfil, progresión y logros (Fase 2) ─────────────────────────────────────
//
// Se guardan en la base de datos y no en el navegador porque son el historial del
// jugador: sobreviven a limpiar la caché y en Fase 3 alimentan las clasificaciones.
// Siguen atados a la cookie anónima: nada de esto exige cuenta.

model PlayerProfile {
  id            String      @id @default(cuid())
  guestId       String      @unique
  guest         GuestPlayer @relation(fields: [guestId], references: [id], onDelete: Cascade)
  displayName   String?
  /// Ids del catálogo de src/domain/players/avatar.ts
  arquetipo     String      @default("presidente")
  colorAvatar   String      @default("verde")
  marco         String      @default("ninguno")
  xp            Int         @default(0)
  gamesFinished Int         @default(0)
  bestScore     Int         @default(0)
  bestStreak    Int         @default(0)
  totalCorrect  Int         @default(0)
  totalAnswers  Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  achievements PlayerAchievement[]
}

model PlayerAchievement {
  id            Int           @id @default(autoincrement())
  profileId     String
  profile       PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Id del catálogo de src/domain/achievements/achievements.ts
  achievementId String
  gameId        String?
  unlockedAt    DateTime      @default(now())

  @@unique([profileId, achievementId])
  @@index([profileId])
}

/// Mejor marca por formato y dificultad: es el fantasma contra el que se compite.
model PersonalBest {
  id           String      @id @default(cuid())
  guestId      String
  guest        GuestPlayer @relation(fields: [guestId], references: [id], onDelete: Cascade)
  formatId     String
  difficultyId String
  score        Int
  accuracy     Float       @default(0)
  bestStreak   Int         @default(0)
  gameId       String
  /// Curva de puntuación de la partida récord.
  trail        Int[]       @default([])
  updatedAt    DateTime    @updatedAt

  @@unique([guestId, formatId, difficultyId])
}

/// Resultado del reto del día. Un intento por jugador y día.
model DailyResult {
  id         String      @id @default(cuid())
  guestId    String
  guest      GuestPlayer @relation(fields: [guestId], references: [id], onDelete: Cascade)
  dailyKey   String
  gameId     String
  score      Int
  accuracy   Float       @default(0)
  durationMs Int         @default(0)
  createdAt  DateTime    @default(now())

  @@unique([guestId, dailyKey])
  @@index([dailyKey, score])
}

// ── FASE 3 · SALAS EN TIEMPO REAL ────────────────────────────────────────────
//
// Decisiones de diseño (el porqué del transporte está en docs/FASE3-REALTIME.md):
//
// 1. LA SALA ES LA AUTORIDAD Y VIVE AQUÍ. No hay estado de juego en memoria de una
//    función serverless: `Room.state` guarda el estado autoritativo completo (validado
//    con Zod en el boundary, igual que `Question.payload`). Dos invocaciones distintas
//    ven exactamente lo mismo.
//
// 2. LOS CLIENTES NO RECIBEN MENSAJES, LEEN UN REGISTRO. `RoomEvent` es append-only con
//    `seq` monotónico por sala. Un cliente que se reconecta pide «lo que haya después de
//    mi seq»: la reconexión es la misma consulta que el caso normal.
//
// 3. CADA EVENTO SABE PARA QUIÉN ES. `RoomEvent.audience` vale 'ALL', 'HOST' o
//    'P:<playerId>'. Es lo que impide que la respuesta correcta viaje al móvil antes del
//    reveal: el evento con la solución tiene audiencia HOST hasta que se revela.
//
// 4. EL CÓDIGO CORTO NO AUTORIZA NADA. `Room.code` sirve para encontrar la sala; para
//    actuar hacen falta `RoomPlayer.token` (jugador) o `Room.hostToken` (host).

enum RoomPhase {
  LOBBY
  COUNTDOWN
  ROUND_INTRO
  QUESTION
  LOCKED
  REVEAL
  SCORE
  ROUND_RESULTS
  FINAL_BET
  GAME_RESULTS
  CLOSED
}

enum RoomPrivacy {
  PRIVADA
  PROTEGIDA
  /// Reservado: no hay directorio público ni matchmaking (y no debe haberlo sin moderación).
  PUBLICA
}

enum RoomTeamMode {
  NINGUNO
  /// Un móvil representa a un equipo entero (reuniones en el mismo salón).
  COMPARTIDO
  /// Cada persona con su móvil, pero suma para su equipo.
  INDIVIDUAL
}

enum RoomLateJoin {
  /// No se entra una vez empezada.
  CERRADO
  /// Se entra, pero como espectador y sin puntuar.
  ESPECTADOR
  /// Se entra hasta que acabe la primera ronda, con puntuación normalizada.
  PRIMERA_RONDA
  ABIERTO
}

enum RoomRole {
  HOST
  PLAYER
  SPECTATOR
}

enum RoomMemberStatus {
  ACTIVE
  RECONNECTING
  AWAY
  KICKED
  LEFT
}

model Room {
  /// Id interno NO adivinable. Es lo que se usa en relaciones y en logs.
  id        String      @id @default(cuid())
  /// Código humano de 4 caracteres sin letras ambiguas. Único mientras la sala vive.
  code      String      @unique
  /// Autorización del host. Nunca se envía a un jugador.
  hostToken String
  phase     RoomPhase   @default(LOBBY)
  privacy   RoomPrivacy @default(PRIVADA)

  teamMode RoomTeamMode @default(NINGUNO)
  lateJoin RoomLateJoin @default(PRIMERA_RONDA)
  /// Entrada cerrada por el host.
  locked   Boolean      @default(false)
  /// true = el juego dirige solo; false = modo presentador (el host avanza a mano).
  autoPilot Boolean @default(true)
  /// Cada cuántas preguntas se muestra la clasificación (0 = solo al final).
  leaderboardEvery Int @default(3)
  reactionsEnabled Boolean @default(true)
  maxPlayers       Int     @default(24)

  /// GameSetup validado con Zod (formato, dificultad, categoría, sin spoilers).
  config Json
  /// Semilla del RNG: la sala es reproducible.
  seed   String
  /// Banco reducido de la partida. Igual que en solitario, permite recargar sin perderla.
  poolIds String[] @default([])

  /// Estado autoritativo completo de la sala (RoomState, validado con Zod al leer).
  state Json
  /// Último `seq` emitido. Se incrementa en la misma transacción que los eventos.
  seq   Int  @default(0)

  /// Cuándo caduca la sala. Las salas son efímeras: el código se puede reutilizar después.
  expiresAt DateTime
  /// Última señal de vida del host: base del periodo de gracia si se le va la conexión.
  hostSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  closedAt   DateTime?

  players RoomPlayer[]
  teams   RoomTeam[]
  answers RoomAnswer[]
  events  RoomEvent[]

  @@index([phase, expiresAt])
  @@index([expiresAt])
}

model RoomPlayer {
  id     String @id @default(cuid())
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  /// Autorización del jugador. Va en el navegador (localStorage) y permite reconectar.
  token  String           @unique
  role   RoomRole         @default(PLAYER)
  status RoomMemberStatus @default(ACTIVE)

  nickname String
  /// Ids del catálogo de src/domain/players/avatar.ts
  arquetipo   String @default("presidente")
  colorAvatar String @default("verde")

  teamId String?
  team   RoomTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  /// Puntuación autoritativa. La calcula el servidor, nunca llega del cliente.
  score      Int @default(0)
  streak     Int @default(0)
  bestStreak Int @default(0)
  correct    Int @default(0)
  answered   Int @default(0)
  /// Suma de tiempos de respuesta, para la estadística de «el más rápido».
  totalResponseMs Int @default(0)
  /// Comodines ya gastados en esta sala.
  powerUpsUsed    String[] @default([])
  /// Puntuación al entrar (late join normalizado): base del cálculo justo.
  joinScore       Int @default(0)
  /// En qué pregunta entró. Sirve para normalizar y para el resumen.
  joinedAtIndex   Int @default(0)

  /// Invitado anónimo asociado, si el jugador ya tenía cookie en este navegador.
  guestId String?

  joinedAt   DateTime @default(now())
  lastSeenAt DateTime @default(now())

  answers   RoomAnswer[]
  reactions RoomReaction[]

  @@unique([roomId, nickname])
  @@index([roomId, status])
  @@index([roomId, score])
}

model RoomTeam {
  id     String @id @default(cuid())
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  /// Puerta del portal: «1.º A», «2.º B»… Nunca un personaje protegido.
  name  String
  color String
  slot  Int

  /// Puntuación de equipo calculada por el servidor (ver domain/party/equipos.ts).
  score Int @default(0)

  players RoomPlayer[]

  @@unique([roomId, slot])
  @@index([roomId])
}

model RoomAnswer {
  id     String @id @default(cuid())
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  playerId String
  player   RoomPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  questionId String
  /// Índice de la pregunta dentro de la partida: con el playerId forma la clave única.
  questionIndex Int
  roundId       String

  /// Id de operación del cliente: hace idempotente el envío (doble tap, reintento).
  opId String

  answered   Boolean @default(true)
  correct    Boolean @default(false)
  accuracy   Float   @default(0)
  responseMs Int     @default(0)

  pointsAwarded Int      @default(0)
  basePoints    Int      @default(0)
  timeBonus     Int      @default(0)
  streakBonus   Int      @default(0)
  multiplier    Float    @default(1)
  streakAfter   Int      @default(0)
  wager         Int?
  powerUpsUsed  String[] @default([])

  /// Lo que envió el jugador (AnswerSubmission).
  submitted Json?
  /// Texto libre de las rondas sociales, ya saneado.
  texto     String?
  /// Votos recibidos en la ronda social.
  votes     Int     @default(0)
  /// El host ha ocultado esta respuesta abierta.
  hidden    Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([roomId, playerId, questionIndex])
  @@unique([roomId, playerId, opId])
  @@index([roomId, questionIndex])
}

model RoomEvent {
  id     BigInt @id @default(autoincrement())
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  /// Monotónico por sala, empieza en 1. Es el cursor del cliente.
  seq  Int
  type String
  /// 'ALL' | 'HOST' | 'P:<playerId>'. Lo que impide filtrar la solución antes del reveal.
  audience String @default("ALL")
  payload  Json

  createdAt DateTime @default(now())

  @@unique([roomId, seq])
  @@index([roomId, seq])
}

/// Reacciones del público. Efímeras y con límite de ritmo; se agregan en la pantalla grande.
model RoomReaction {
  id       BigInt     @id @default(autoincrement())
  roomId   String
  playerId String
  player   RoomPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  emoji    String
  at       DateTime   @default(now())

  @@index([roomId, at])
}

// ── FASE 4 · CUENTAS, PROGRESIÓN, COMUNIDAD Y NOTIFICACIONES ─────────────────
//
// Principios que se respetan aquí (el porqué está en docs/FASE4-RETENCION.md):
//
// 1. JUGAR PRIMERO, REGISTRARSE DESPUÉS. `GuestPlayer` (Fase 1) sigue siendo el sujeto
//    real del juego. Una `UserAccount` es algo que se le ATA encima, no algo que lo
//    sustituya: por eso la migración de invitado a cuenta es un `UPDATE` de una columna
//    y no una copia de datos que se pueda quedar a medias.
//
// 2. EL XP ES UN LIBRO MAYOR, NO UN CONTADOR. `XpTransaction` guarda cada concesión con
//    su motivo y su origen, y `UserProfile.xp` es solo la suma cacheada. Sin esto, un
//    reintento duplica XP y no hay forma de auditarlo. La clave única por
//    (usuario, motivo, origen) hace que conceder dos veces lo mismo sea imposible.
//
// 3. LO QUE CADUCA, CADUCA EN LA BASE DE DATOS. Invitaciones, desafíos y notificaciones
//    llevan `expiresAt`. Nada de «Pablo te invita» cuatro horas después de que la partida
//    terminara.
//
// 4. LA PRIVACIDAD ES UNA COLUMNA, NO UN `if` EN LA UI. Cada cosa que se puede ver tiene
//    su nivel (TODOS / AMIGOS / NADIE) y se comprueba en el servidor.

enum VisibilidadPerfil {
  TODOS
  AMIGOS
  NADIE
}

enum EstadoAmistad {
  PENDIENTE
  ACEPTADA
  RECHAZADA
  CANCELADA
}

enum EstadoCuenta {
  ACTIVA
  SUSPENDIDA
  BANEADA
  /// Ha pedido borrarse: hay periodo de gracia para arrepentirse.
  PENDIENTE_BORRADO
}

enum CanalNotificacion {
  IN_APP
  PUSH
  EMAIL
}

enum EstadoEnvio {
  PENDIENTE
  ENVIADA
  ENTREGADA
  ABIERTA
  FALLIDA
  /// Descartada por preferencias, horario silencioso o tope de frecuencia.
  DESCARTADA
}

enum EstadoDesafio {
  ABIERTO
  COMPLETADO
  CADUCADO
  RECHAZADO
}

/// Cuenta opcional. Nunca es obligatoria para jugar.
model UserAccount {
  id     String       @id @default(cuid())
  email  String       @unique
  estado EstadoCuenta @default(ACTIVA)

  /// Nombre público único. NUNCA se usa para identificar internamente: para eso está `id`.
  username         String   @unique
  /// Cuándo se cambió por última vez: hay enfriamiento para que no sea un nombre volátil.
  usernameChangedAt DateTime?
  /// Código para añadir amigos sin exponer el id interno: «PACO-82K7».
  friendCode       String   @unique

  /// Zona horaria IANA del usuario. Decide su día para la racha y sus horas silenciosas.
  timezone String @default("Europe/Madrid")
  locale   String @default("es-ES")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastSeenAt  DateTime  @default(now())
  /// Cuándo se podrá borrar de verdad, si lo ha pedido.
  deleteAfter DateTime?

  guests        GuestPlayer[]
  profile       UserProfile?
  settings      UserSettings?
  sessions      UserSession[]
  xp            XpTransaction[]
  streak        Streak?
  logros        UserAchievement[]
  insignias     UserBadge[]
  suscripciones PushSubscription[]
  notificaciones Notification[]
  envios        NotificationDelivery[]
  amistadesA    Friendship[]           @relation("amistadA")
  amistadesB    Friendship[]           @relation("amistadB")
  solicitudesEnviadas  FriendRequest[] @relation("solicitante")
  solicitudesRecibidas FriendRequest[] @relation("destinatario")
  bloqueosHechos  Block[]              @relation("bloqueador")
  bloqueosSufridos Block[]             @relation("bloqueado")
  desafiosEnviados  Challenge[]        @relation("retador")
  participaciones   ChallengeParticipant[]
  comunidades       CommunityMember[]
  ligas             LeagueParticipant[]
  temporadas        UserSeasonProgress[]
  actividad         ActivityEvent[]
  reportesHechos    Report[]           @relation("reportante")
  reportesRecibidos Report[]           @relation("reportado")

  @@index([estado, lastSeenAt])
  @@index([deleteAfter])
}

/// Sesión con dispositivo. Cerrar sesión en el móvil no debe tirar la del portátil.
model UserSession {
  id        String      @id @default(cuid())
  userId    String
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Hash del token de sesión. El token en claro solo existe en la cookie del navegador.
  tokenHash String      @unique
  /// Nombre legible del dispositivo, para la pantalla de «sesiones activas».
  dispositivo String?
  userAgent   String?
  /// Solo el prefijo de la IP, para detectar sesiones raras sin guardar la IP entera.
  ipPrefijo   String?
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  @@index([userId, expiresAt])
}

/// Enlaces mágicos y códigos de acceso. De un solo uso y con vida corta.
model LoginToken {
  id        String   @id @default(cuid())
  /// Hash del código. Nunca se guarda el código en claro.
  tokenHash String   @unique
  email     String
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  /// Intentos fallidos contra este token: freno a la fuerza bruta.
  intentos  Int      @default(0)

  @@index([email, createdAt])
  @@index([expiresAt])
}

/// Perfil público. Se crea al crear la cuenta y hereda lo del invitado.
model UserProfile {
  userId String      @id
  user   UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String?
  titulo      String? // título cosmético desbloqueado
  arquetipo   String  @default("presidente")
  colorAvatar String  @default("verde")
  marco       String  @default("ninguno")
  fondo       String  @default("ninguno")

  /// Suma cacheada del libro mayor. La verdad está en `XpTransaction`.
  xp    Int @default(0)
  nivel Int @default(1)
  /// Id del rango temático (src/domain/progression).
  rango String @default("visitante")

  /// Habilidad estimada, SEPARADA del XP: el XP es tiempo jugado, esto es acierto.
  skillRating   Int @default(1000)
  skillPartidas Int @default(0)

  partidas   Int   @default(0)
  victorias  Int   @default(0)
  aciertos   Int   @default(0)
  respuestas Int   @default(0)
  mejorRacha Int   @default(0)
  /// Categoría con más aciertos, para el perfil.
  categoriaFavorita String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([xp])
  @@index([skillRating])
}

model UserSettings {
  userId String      @id
  user   UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Privacidad (§63) ──
  perfilVisible      VisibilidadPerfil @default(TODOS)
  estadisticasVisibles VisibilidadPerfil @default(TODOS)
  presenciaVisible   VisibilidadPerfil @default(AMIGOS)
  actividadVisible   VisibilidadPerfil @default(AMIGOS)
  quienPuedeInvitar  VisibilidadPerfil @default(AMIGOS)
  quienPuedeRetar    VisibilidadPerfil @default(AMIGOS)
  quienPuedeSolicitar VisibilidadPerfil @default(TODOS)

  // ── Horario silencioso (§36). Minutos desde medianoche en hora local. ──
  silencioActivo Boolean @default(true)
  silencioDesde  Int     @default(1380) // 23:00
  silencioHasta  Int     @default(540)  // 09:00

  /// Hora habitual de juego, en minutos locales. Se aprende del uso, no se pregunta.
  horaHabitual Int?

  reduccionMovimiento Boolean @default(false)
  sonido              Boolean @default(true)

  updatedAt DateTime @updatedAt

  preferencias NotificationPreference[]
}

/// Preferencia por categoría y canal: nada de un único interruptor gigante (§35).
model NotificationPreference {
  id        String            @id @default(cuid())
  userId    String
  settings  UserSettings      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  /// Id de la categoría (src/domain/notificaciones/catalogo.ts).
  categoria String
  canal     CanalNotificacion
  activa    Boolean           @default(true)

  @@unique([userId, categoria, canal])
  @@index([userId])
}

/// LIBRO MAYOR DE XP. Cada línea es una concesión, con su motivo y su origen.
model XpTransaction {
  id     String      @id @default(cuid())
  userId String
  user   UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  cantidad Int
  /// Motivo del catálogo (PARTIDA_TERMINADA, RETO_DIARIO, LOGRO…).
  motivo   String
  /// Qué lo originó: id de partida, de reto, de logro. Con el motivo forma la clave.
  sourceId String

  /// XP que se ha recortado por tope diario o rendimientos decrecientes, para poder
  /// explicárselo al jugador («hoy ya has sacado el máximo de partidas rápidas»).
  recortado Int @default(0)

  createdAt DateTime @default(now())

  @@unique([userId, motivo, sourceId])
  @@index([userId, createdAt])
  @@index([userId, motivo, createdAt])
}

/// Racha diaria. Un día cuenta si hubo actividad SIGNIFICATIVA, no por abrir la app.
model Streak {
  userId String      @id
  user   UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  actual Int @default(0)
  mejor  Int @default(0)
  /// Último día local con actividad válida (YYYY-MM-DD en la zona del usuario).
  ultimoDia String?
  /// Seguros de derrama disponibles: cubren un día perdido.
  seguros   Int @default(0)
  /// Cuántos días se han salvado con seguro, para no regalarlos sin límite.
  segurosUsados Int @default(0)

  /// Misión de recuperación abierta tras romper una racha larga.
  recuperacionHasta   DateTime?
  recuperacionObjetivo Int      @default(0)
  recuperacionHechos   Int      @default(0)
  /// Racha que se recupera si se completa la misión.
  recuperacionRacha    Int      @default(0)

  updatedAt DateTime @updatedAt
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  unlockedAt    DateTime    @default(now())
  /// Qué lo desbloqueó, para poder enseñarlo y para la idempotencia.
  sourceId      String?

  @@unique([userId, achievementId])
  @@index([userId, unlockedAt])
}

model UserBadge {
  id       String      @id @default(cuid())
  userId   String
  user     UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  String
  /// Si el jugador la ha puesto en su perfil.
  destacada Boolean    @default(false)
  earnedAt DateTime    @default(now())

  @@unique([userId, badgeId])
  @@index([userId, destacada])
}

// ── Social ──────────────────────────────────────────────────────────────────

/// Amistad ya aceptada. Se guarda UNA fila con los ids ordenados, para no duplicar.
model Friendship {
  id      String      @id @default(cuid())
  aId     String
  a       UserAccount @relation("amistadA", fields: [aId], references: [id], onDelete: Cascade)
  bId     String
  b       UserAccount @relation("amistadB", fields: [bId], references: [id], onDelete: Cascade)
  since   DateTime    @default(now())
  /// Partidas jugadas juntos, para el «tú vs Pablo».
  juntos  Int         @default(0)

  @@unique([aId, bId])
  @@index([aId])
  @@index([bId])
}

model FriendRequest {
  id             String        @id @default(cuid())
  solicitanteId  String
  solicitante    UserAccount   @relation("solicitante", fields: [solicitanteId], references: [id], onDelete: Cascade)
  destinatarioId String
  destinatario   UserAccount   @relation("destinatario", fields: [destinatarioId], references: [id], onDelete: Cascade)
  estado         EstadoAmistad @default(PENDIENTE)
  mensaje        String?
  createdAt      DateTime      @default(now())
  resueltaAt     DateTime?

  @@unique([solicitanteId, destinatarioId])
  @@index([destinatarioId, estado])
}

/// Bloqueo. Al bloqueado NO se le avisa (§64).
model Block {
  id           String      @id @default(cuid())
  bloqueadorId String
  bloqueador   UserAccount @relation("bloqueador", fields: [bloqueadorId], references: [id], onDelete: Cascade)
  bloqueadoId  String
  bloqueado    UserAccount @relation("bloqueado", fields: [bloqueadoId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@unique([bloqueadorId, bloqueadoId])
  @@index([bloqueadoId])
}

/// Desafío asíncrono: A juega, B intenta superarlo con la MISMA semilla.
model Challenge {
  id        String        @id @default(cuid())
  retadorId String
  retador   UserAccount   @relation("retador", fields: [retadorId], references: [id], onDelete: Cascade)
  estado    EstadoDesafio @default(ABIERTO)

  /// Semilla y configuración: es lo que garantiza que juegan lo mismo.
  seed      String
  config    Json
  /// Etiqueta legible para compartir.
  etiqueta  String  @unique

  /// Marca del retador. Se rellena cuando termina su partida.
  puntosRetador Int?
  gameIdRetador String?

  /// Reto de grupo: varios amigos, mismo desafío, plazo común.
  esGrupal Boolean @default(false)

  createdAt DateTime @default(now())
  expiresAt DateTime

  participantes ChallengeParticipant[]

  @@index([retadorId, estado])
  @@index([expiresAt])
}

model ChallengeParticipant {
  id          String      @id @default(cuid())
  challengeId String
  challenge   Challenge   @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  puntos    Int?
  precision Float?
  gameId    String?
  jugadoAt  DateTime?
  /// Es una revancha de otro desafío.
  revanchaDe String?

  createdAt DateTime @default(now())

  @@unique([challengeId, userId])
  @@index([userId, jugadoAt])
}

/// Comunidad: grupo privado ligero. NO es un chat.
model Community {
  id          String   @id @default(cuid())
  nombre      String
  icono       String   @default("🏢")
  /// Código de invitación. Se puede regenerar.
  codigo      String   @unique
  descripcion String?
  createdAt   DateTime @default(now())

  miembros CommunityMember[]

  @@index([codigo])
}

model CommunityMember {
  id          String      @id @default(cuid())
  communityId String
  community   Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  esAdmin     Boolean     @default(false)
  joinedAt    DateTime    @default(now())
  /// Puntuación normalizada de la comunidad, recalculada por el job semanal.
  puntosSemana Int        @default(0)
  puntosMes    Int        @default(0)
  puntosTotal  Int        @default(0)

  @@unique([communityId, userId])
  @@index([communityId, puntosSemana])
}

// ── Temporadas y ligas ──────────────────────────────────────────────────────

model Season {
  id        String   @id @default(cuid())
  nombre    String
  slug      String   @unique
  empiezaAt DateTime
  terminaAt DateTime
  activa    Boolean  @default(false)
  /// Retos y recompensas de la temporada, como datos: se cambian sin tocar código.
  config    Json

  ligas     LeagueSeason[]
  progresos UserSeasonProgress[]

  @@index([activa, terminaAt])
}

model UserSeasonProgress {
  id       String      @id @default(cuid())
  seasonId String
  season   Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  userId   String
  user     UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  xp       Int         @default(0)
  retos    Json        @default("{}")

  @@unique([seasonId, userId])
  @@index([seasonId, xp])
}

/// Una liga es un nivel (Portal, Bronce…). Una temporada de liga son sus grupos.
model LeagueSeason {
  id        String   @id @default(cuid())
  seasonId  String
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  /// Id del nivel de liga (src/domain/ligas).
  liga      String
  empiezaAt DateTime
  terminaAt DateTime
  cerrada   Boolean  @default(false)

  grupos LeagueGroup[]

  @@unique([seasonId, liga])
  @@index([terminaAt, cerrada])
}

/// Grupo pequeño: se compite contra 20-30 personas, no contra el mundo.
model LeagueGroup {
  id             String       @id @default(cuid())
  leagueSeasonId String
  leagueSeason   LeagueSeason @relation(fields: [leagueSeasonId], references: [id], onDelete: Cascade)
  numero         Int

  participantes LeagueParticipant[]

  @@unique([leagueSeasonId, numero])
}

model LeagueParticipant {
  id      String      @id @default(cuid())
  groupId String
  group   LeagueGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Puntos de liga. NO son XP: se calculan aparte y tienen tope diario.
  puntos      Int @default(0)
  puntosHoy   Int @default(0)
  /// Día local del último punto, para reiniciar el tope.
  ultimoDia   String?
  posicionFinal Int?
  /// ASCIENDE | MANTIENE | DESCIENDE, al cerrar.
  resultado   String?

  updatedAt DateTime @updatedAt

  @@unique([groupId, userId])
  @@index([groupId, puntos])
  @@index([userId])
}

// ── Notificaciones ──────────────────────────────────────────────────────────

/// Buzón dentro de la app. SIEMPRE se escribe, aunque el push esté apagado (§91).
model Notification {
  id       String      @id @default(cuid())
  userId   String
  user     UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo     String
  categoria String
  titulo   String
  cuerpo   String
  /// Adónde lleva al pulsarla. Nunca a la portada (§56).
  deepLink String
  payload  Json?
  prioridad Int        @default(0)

  createdAt DateTime  @default(now())
  readAt    DateTime?
  expiresAt DateTime?

  envios NotificationDelivery[]

  @@index([userId, readAt, createdAt])
  @@index([expiresAt])
}

model PushSubscription {
  id       String      @id @default(cuid())
  userId   String
  user     UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint String      @unique
  p256dh   String
  auth     String
  /// Para la pantalla de dispositivos.
  dispositivo String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  lastOkAt    DateTime?
  /// Fallos seguidos: a partir de un umbral se da por muerta y se borra.
  fallos      Int       @default(0)

  @@index([userId])
}

/// Un envío por canal. Es la tabla que responde a «¿por qué no me llegó?».
model NotificationDelivery {
  id             String            @id @default(cuid())
  notificationId String?
  notification   Notification?     @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  userId         String
  user           UserAccount       @relation(fields: [userId], references: [id], onDelete: Cascade)
  canal          CanalNotificacion
  tipo           String
  categoria      String
  estado         EstadoEnvio       @default(PENDIENTE)
  /// Por qué se descartó, si se descartó: PREFERENCIA, SILENCIO, TOPE, SIN_DISPOSITIVO…
  motivoDescarte String?
  /// Variante del experimento, si lo hubiera.
  variante       String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?
  openedAt  DateTime?

  @@index([userId, createdAt])
  @@index([tipo, estado, createdAt])
}

/// Muro de actividad muy pequeño: solo hitos, nunca cada respuesta (§31).
model ActivityEvent {
  id       String      @id @default(cuid())
  userId   String
  user     UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo     String
  texto    String
  deepLink String?
  payload  Json?
  createdAt DateTime   @default(now())

  @@index([userId, createdAt])
}

model Report {
  id           String      @id @default(cuid())
  reportanteId String
  reportante   UserAccount @relation("reportante", fields: [reportanteId], references: [id], onDelete: Cascade)
  reportadoId  String
  reportado    UserAccount @relation("reportado", fields: [reportadoId], references: [id], onDelete: Cascade)
  motivo       String
  detalle      String?
  resuelto     Boolean     @default(false)
  resueltoPor  String?
  createdAt    DateTime    @default(now())

  @@index([resuelto, createdAt])
  @@index([reportadoId])
}

/// Registro de acciones administrativas. Todo lo que un admin hace queda escrito.
model AdminAudit {
  id        String   @id @default(cuid())
  actor     String
  accion    String
  objetivo  String?
  detalle   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
