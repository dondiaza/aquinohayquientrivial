# Copia este fichero a .env y ajusta si hace falta.
#
# Desarrollo local: `npm run db:up` levanta un PostgreSQL embebido en el puerto 5434
# y guarda los datos en ./.pgdata (no requiere Docker ni instalar PostgreSQL).
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/ahqv_trivial?schema=public"

# Producción (Neon / Vercel Postgres): usa el pooler para la app y la conexión
# DIRECTA para las migraciones. Si defines DATABASE_URL_UNPOOLED, añade también
# `directUrl = env("DATABASE_URL_UNPOOLED")` al datasource de prisma/schema.prisma.
# DATABASE_URL_UNPOOLED=""

# Panel de administración. Si se define, /admin pide esta clave (cabecera/cookie).
# En blanco = panel abierto (solo recomendable en local).
ADMIN_PASSWORD=""

# ── Fase 4 · cuentas, notificaciones y trabajos programados ────────────────────
#
# Todo lo de aquí es OPCIONAL: sin nada de esto el juego funciona igual. Lo que cambia es
# que no salen correos de verdad, no hay push y los trabajos programados no se pueden
# disparar desde fuera.

# Correo del enlace mágico. Sirve cualquier proveedor que acepte un POST con JSON
# (Resend, Postmark, Brevo, un webhook propio…). Si no está definido, en desarrollo el
# código de acceso se escribe en la consola del servidor y NO se manda nada.
# EMAIL_ENDPOINT=""
# EMAIL_TOKEN=""
# EMAIL_FROM="Desengaño 21 <portal@tu-dominio>"

# Web Push. Las claves se generan una vez con:  npx web-push generate-vapid-keys
# La pública también se necesita en el navegador para suscribirse.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:portal@tu-dominio"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Trabajos programados. Los dispara GitHub Actions llamando a /api/jobs con este secreto.
# Si no está definido, la ruta responde 503 y no ejecuta nada (falla hacia el lado seguro).
# JOBS_SECRET=""

# URL pública del sitio. Se usa para el QR de las salas y para los enlaces de las
# notificaciones. Si no está, se deduce de la cabecera host, que es lo que hace que jugar
# en el wifi de casa funcione sin configurar nada.
# NEXT_PUBLIC_SITE_URL="https://tu-dominio"
