{
  "name": "aquinohayquientrivial",
  "version": "0.1.0",
  "private": true,
  "description": "El Trivial de la Comunidad — trivial/party-game de comunidad de vecinos (Fase 1)",
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "prisma generate && next build",
    "start": "next start -p 3210",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "node scripts/dev-db.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "setup": "prisma migrate deploy && prisma generate && tsx prisma/seed.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "banco:auditar": "node scripts/auditar-banco.mjs",
    "banco:curar": "tsx scripts/curar-banco.ts",
    "medios:barrer": "node scripts/barrer-commons.mjs --bajar && node scripts/optimizar-medios.mjs && node scripts/generar-manifiesto-commons.mjs",
    "medios:aquinolab": "node scripts/importar-aquinolab.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^16.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "postcss": "^8.5.26",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.11"
  }
}
